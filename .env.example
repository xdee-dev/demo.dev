# ─────────────────────────────────────────────────────────────────────────────
# Rental Management System — environment variables
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development            # development | production
PORT=4000                       # API (and, in production, the web app) port

# PostgreSQL connection. The user MUST NOT be a superuser (Row-Level Security would be bypassed).
DATABASE_URL=postgres://rental_app:GANTI_PASSWORD_INI@localhost:5432/rental_db
# Separate database used by `npm test` (it is wiped on every test run!)
TEST_DATABASE_URL=postgres://rental_app:GANTI_PASSWORD_INI@localhost:5432/rental_test

# Public URL of the web app (used in password-reset and invitation emails)
APP_URL=http://localhost:5173

SESSION_TTL_HOURS=12            # sliding session lifetime
# COOKIE_SECURE=true            # default: true in production (requires HTTPS). Set false ONLY for a trusted LAN without HTTPS.
# TRUST_PROXY=1                 # number of reverse proxies in front of the app (nginx/Caddy = 1)

STORAGE_DIR=./storage           # uploaded files (vehicle photos, ID cards, payment proofs). Back this folder up!
MAX_UPLOAD_MB=5

# Email (password reset & invitations). Without SMTP_HOST, emails are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rental Management System <no-reply@domainanda.co.id>"

# Seed data (development/demo only). Must contain upper+lower case letters and digits, min 10 chars.
SEED_DEMO_PASSWORD=
# MIGRATE_ON_START=true          # run database migrations automatically when the server starts
